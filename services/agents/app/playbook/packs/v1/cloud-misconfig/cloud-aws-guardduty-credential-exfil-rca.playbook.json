{
  "id": "cloud-aws-guardduty-credential-exfil-rca-v1",
  "name": "AWS GuardDuty & CloudTrail: Instance Credential Exfiltration RCA",
  "description": "Triggered by AWS GuardDuty EC2/ECS instance credential exfiltration findings (UnauthorizedAccess:IAMUser/InstanceCredentialExfiltration.OutsideAWS). Enriches external IP, correlates CloudTrail calls made with the stolen IMDS role credentials for full RCA, blocks the external attacker IP, and revokes the compromised IAM role session.",
  "version": "1.0.0",
  "tags": [
    "cloud-misconfig",
    "cloud",
    "aws",
    "guardduty",
    "cloudtrail",
    "imds",
    "credentials",
    "rca",
    "mitre.t1552.005"
  ],
  "trigger": {
    "on": "alert",
    "severity": [
      "critical"
    ],
    "tags": [
      "cloud-misconfig",
      "guardduty",
      "aws-guardduty",
      "cloudtrail"
    ]
  },
  "author": "AiSOC",
  "enabled": true,
  "created_at": "2026-05-03T00:00:00+00:00",
  "updated_at": "2026-05-03T00:00:00+00:00",
  "steps": [
    {
      "id": "enrich-exfil-ip",
      "name": "Enrich external IP using stolen IMDS credentials",
      "type": "enrich",
      "params": {
        "indicator_field": "alert.src_ip"
      },
      "on_failure": "continue",
      "retry_max": 0,
      "timeout_seconds": 30
    },
    {
      "id": "block-exfil-ip",
      "name": "Block external credential-replay IP at perimeter",
      "type": "block_ip",
      "params": {
        "ip_field": "alert.src_ip",
        "duration": "24h"
      },
      "on_failure": "abort",
      "retry_max": 0,
      "timeout_seconds": 20
    },
    {
      "id": "revoke-imds-role",
      "name": "Attach inline deny-all token revocation policy to compromised EC2 IAM role",
      "type": "http",
      "params": {
        "url": "${AWS_URL}/iam/{{alert.role}}/sessions/revoke-all",
        "method": "POST"
      },
      "on_failure": "continue",
      "retry_max": 0,
      "timeout_seconds": 20
    },
    {
      "id": "rca-imds-exfil",
      "name": "AI Root Cause Analysis: trace SSRF/IMDSv1 vector on instance & enumerate S3/SecretsManager calls by stolen token",
      "type": "investigate",
      "params": {
        "case_id_field": "alert.case_id",
        "focus": "cloud"
      },
      "on_failure": "continue",
      "retry_max": 0,
      "timeout_seconds": 180
    },
    {
      "id": "page-cloud-ir",
      "name": "Page Cloud Incident Response on-call",
      "type": "notify",
      "params": {
        "channel": "pagerduty",
        "message_template": "GuardDuty IMDS credential exfiltration on {{alert.role}} from {{alert.src_ip}}. Role sessions revoked & RCA attached.",
        "service_key_env": "PD_CLOUD_KEY"
      },
      "on_failure": "continue",
      "retry_max": 0,
      "timeout_seconds": 10
    },
    {
      "id": "ticket-guardduty-imds",
      "name": "Open P1 GuardDuty IMDS credential exfil RCA ticket",
      "type": "create_ticket",
      "params": {
        "priority": "P1",
        "title_template": "GuardDuty IMDS Exfil RCA: {{alert.role}}",
        "queue": "soc"
      },
      "on_failure": "continue",
      "retry_max": 0,
      "timeout_seconds": 20
    }
  ]
}
