# CloudifyOps SOC (clops-soc) — Shared EC2 Preview Environment Overrides
#
# Usage on EC2:
#   cp .env.example .env
#   cat .env.ec2.example >> .env
#   # Edit PUBLIC_HOST in .env to your EC2 public IP or hostname
#   python3 scripts/ensure_env.py
#
# IMPORTANT: NEXT_PUBLIC_WS_URL and NEXT_PUBLIC_REALTIME_URL are baked into
# the Next.js browser bundle at image build time. If you change PUBLIC_HOST or
# REALTIME_PORT later, rebuild `web`:
#   docker compose build web && docker compose up -d web

TAG=local

# EC2 public IP or DNS name accessed from your browser:
PUBLIC_HOST=localhost

# Publicly exposed host ports (0.0.0.0) — isolated from existing aisoc-* stack:
WEB_PORT=13000
REALTIME_PORT=18086

# Loopback-only host ports (127.0.0.1) — datastores (postgres, redis, kafka, zookeeper) stay unpublished:
API_PORT=18000
AGENTS_PORT=18001
ACTIONS_PORT=18002
FUSION_PORT=18003
THREATINTEL_PORT=18005
INGEST_HTTP_PORT=18081
INGEST_METRICS_PORT=19090
CONNECTORS_PORT=18088
LITELLM_PORT=14000
QDRANT_PORT=16333
OLLAMA_PORT=21434

# Console navigation feature flags (build-time for web):
NEXT_PUBLIC_NAV_RUNBOOKS_ENABLED=true
NEXT_PUBLIC_NAV_ANALYTICS_ENABLED=true

# Optional overrides (derived automatically in docker-compose.yml if omitted):
# NEXT_PUBLIC_WS_URL=
# NEXT_PUBLIC_REALTIME_URL=
# AISOC_CORS_ORIGINS=
# AISOC_CONSOLE_URL=
